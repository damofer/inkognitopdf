{
  "name": "inkognitopdf",
  "version": "0.1.0",
  "private": true,
  "description": "Editor de PDF open source que procesa todo en el dispositivo del usuario.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "predev": "node scripts/copy-pdfjs-assets.mjs",
    "prebuild": "node scripts/copy-pdfjs-assets.mjs",
    "pretest:e2e": "npm run build"
  },
  "dependencies": {
    "@expo-google-fonts/caveat": "0.4.2",
    "@expo-google-fonts/dancing-script": "0.4.2",
    "@expo-google-fonts/great-vibes": "0.4.1",
    "@firebase/analytics": "0.10.25",
    "@firebase/app": "0.16.3",
    "@pdf-lib/fontkit": "1.1.1",
    "@pdf-lib/standard-fonts": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tesseract.js-data/spa": "1.0.0",
    "asn1js": "3.0.10",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "pkijs": "3.4.1",
    "prosemirror-commands": "1.7.2",
    "prosemirror-history": "1.5.1",
    "prosemirror-inputrules": "1.5.1",
    "prosemirror-keymap": "1.2.3",
    "prosemirror-model": "1.25.12",
    "prosemirror-schema-list": "1.5.1",
    "prosemirror-state": "1.4.4",
    "prosemirror-transform": "1.12.2",
    "prosemirror-view": "1.42.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@expo-google-fonts/arimo": "0.4.3",
    "@expo-google-fonts/caladea": "0.4.2",
    "@expo-google-fonts/carlito": "0.4.1",
    "@expo-google-fonts/cousine": "0.4.3",
    "@expo-google-fonts/tinos": "0.4.2",
    "@napi-rs/canvas": "1.0.11",
    "@playwright/test": "1.64.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "firebase-tools": "15.34.0",
    "globals": "17.13.0",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4"
  }
}
